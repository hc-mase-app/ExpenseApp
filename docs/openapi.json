    "/claims": {
      "post": {
        "summary": "Ajukan/kirim ulang klaim",
        "description": "Akses: HR/Karyawan. multipart/form-data: category, date, provider, items (JSON string array desc/amount). Opsional: purpose, expenseType, actingEmployee (wajib untuk HR), editId (klaim returned), files (berulang), approvalFiles (expense), priorApproval, duplicateReason, duplicateConfirmed. Khusus Expense: expenseCompanyId wajib berasal dari expenseCompanies pada GET /state.",
        "operationId": "post_claims",
        "tags": [
          "API internal"
        ],
        "responses": {
          "400": {
            "description": "Validasi gagal"
          },
          "401": {
            "description": "Sesi/kredensial tidak valid"
          },
          "403": {
            "description": "Akses ditolak"
          },
          "409": {
            "description": "Konflik versi/status/duplikat"
          },
          "201": {
            "description": "Sumber berhasil dibuat"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "expenseCompanyId": {
                    "type": "string",
                    "description": "Wajib khusus category=expense. ID master perusahaan dari GET /state.expenseCompanies."
                  }
                }
              }
            }
          },
          "description": "multipart/form-data: category, date, provider, items (JSON string array desc/amount). Opsional: purpose, expenseType, actingEmployee (wajib untuk HR), editId (klaim returned), files (berulang), approvalFiles (expense), priorApproval, duplicateReason, duplicateConfirmed."
        }
      }
    },
