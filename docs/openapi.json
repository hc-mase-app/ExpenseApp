      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "abt_session",
        "description": "Cookie sesi hasil POST /login; bukan API key terpisah. Mode Uji menggunakan abt_test_session."
      }
    }
  },
