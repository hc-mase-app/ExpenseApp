# Include in the nginx http context. Replace example.com and certificate paths.
# Node ports are published on loopback only by compose.yml.
limit_req_zone $binary_remote_addr zone=abt_auth:10m rate=6r/m;

server {
    listen 80;
    server_name benefits.example.com benefits-test.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name benefits.example.com;
    ssl_certificate /etc/nginx/certs/company-fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/company-private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    client_max_body_size 250m;
    client_body_timeout 120s;

    location ~ ^/api/(login|change-password)$ {
        limit_req zone=abt_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
}

# Enable this virtual host only after test DB/service and its DNS/TLS are ready.
server {
    listen 443 ssl;
    server_name benefits-test.example.com;
    ssl_certificate /etc/nginx/certs/company-fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/company-private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    client_max_body_size 250m;
    client_body_timeout 120s;
    location ~ ^/api/(login|change-password)$ {
        limit_req zone=abt_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
}
