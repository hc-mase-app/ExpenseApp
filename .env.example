# Copy to .env and set the real HTTPS hostnames. Never commit .env.
ABT_DEPLOYMENT=server
ABT_DATA_ROOT=/var/lib/benefits-expenses
ABT_INSTANCE_ID=replace-with-unique-customer-id
ABT_PUBLIC_URL=https://benefits.example.com/
ABT_COOKIE_SECURE=1
ABT_ENABLE_TEST_MODE=0
ABT_TEST_PUBLIC_URL=https://benefits-test.example.com/
ABT_TEST_INTERNAL_URL=http://test:3101/
ABT_TEST_MANAGED=1
ABT_MAINTENANCE=0
PORT=3100
ABT_BIND_HOST=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Jakarta
